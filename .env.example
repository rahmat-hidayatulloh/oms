# =============================================================================
# OMS — Contoh Environment Variables (.env.example)
# =============================================================================
# WARNING: JANGAN commit/kirim nilai rahasia ke git!
# Salin file ini menjadi `.env` lalu isi nilai sesuai kepemilikan environment:
#     cp .env.example .env
#
# Cara pakai:
#   1) Docker Compose / konfigurasi container  -> `env_file: [.env]`
#   2) Shell (ekspor sementara di terminal):
#        set -a; source .env; set +a
#   3) CI/CD (GitHub Actions)                  -> petakan ke `${{ secrets.* }}`
#   4) Alternatif konfig Spring Boot            -> copy nilai ke
#       env/omsdb-<profile>.properties (otomatis ke-import via spring.config.import)
#
# Catatan: Spring Boot tidak membaca `.env` secara langsung; file ini adalah
# template nilai yang akan diekspos ke environment proses/container.
# Semua secret diberi nilai kosong / placeholder — isi dari environment.
# =============================================================================

# ----------------------------------------------------------------------------
# Spring Profile — WAJIB (tidak ada default di application.yml)
# Nilai: dev | staging | prod
# ----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ----------------------------------------------------------------------------
# Database (diperlukan untuk profile staging/prod — PostgreSQL)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omsdb_staging
DB_USERNAME=oms_user
# Secret — isi dari environment / GitHub Actions secret (`secrets.DB_PASSWORD`)
DB_PASSWORD=

# ----------------------------------------------------------------------------
# JWT (HS256, minimal 32 karakter) — WAJIB di staging/prod
# `application-dev.yml` punya fallback dev-only, tetapi non-dev gagal startup
# bila JWT_SECRET tidak diset.
# ----------------------------------------------------------------------------
# Secret — isi placeholder di bawah (min 32 karakter acak) dari secret manager
JWT_SECRET=${JWT_SECRET:<CHANGE_ME_MIN_32_CHARS>}
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ----------------------------------------------------------------------------
# Redis (staging/prod; dev memakai in-memory tanpa Redis)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Secret — kosongkan bila Redis tanpa autentikasi
REDIS_PASSWORD=
# 0=dev, 1=staging, 2=prod (lihat env/omsdb-*.properties), default yml=9
REDIS_DATABASE=1

# ----------------------------------------------------------------------------
# Aplikasi / Health Check / Error
# ----------------------------------------------------------------------------
# Health URL payment API — default mock lokal (ariefwara/mock-bi-snap)
HEALTH_URL=http://localhost:9090/health
# Base URL untuk RFC 7807 ProblemDetail
ERROR_BASE_URL=https://api.oms.com/errors
# Aktifkan rate limiting terdistribusi via Redis (true) / in-JVM (false)
RATE_LIMIT_DISTRIBUTED=false

# ----------------------------------------------------------------------------
# Tracing (Zipkin) — wajib di staging/prod (tidak ada default di profile yml)
# ----------------------------------------------------------------------------
ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans

# ----------------------------------------------------------------------------
# Seeding / Operasional
# ----------------------------------------------------------------------------
# Admin password untuk seed-data.sh & Flyway V5 — WAJIB saat seed/run non-dev.
# Secret — isi dari environment / GitHub Actions secret (`secrets.ADMIN_PASSWORD`)
ADMIN_PASSWORD=

# Flag JVM opsional untuk menjalankan container (mis. image Docker)
JAVA_OPTS=-XX:+UseZGC -Xmx512m

# =============================================================================
# Referensi profil tersedia: dev (H2 in-memory), staging, prod (PostgreSQL+Redis)
# =============================================================================