# Development Environment Variables
# ============================================
# WARNING: Jangan commit secrets nyata ke git!
# File ini hanya contoh konfigurasi dengan placeholder.
# Development dapat menggunakan nilai default.
# ============================================

# JWT Configuration
# ⚠️  SECURITY: Replace with your own dev-only secret (min 32 chars).
# The previous literal value has been rotated and removed from Git.
JWT_SECRET=${JWT_SECRET:<CHANGE_ME_MIN_32_CHARS>}
JWT_EXPIRATION=86400000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD:}
REDIS_DATABASE=0