# Production Environment Variables
# ============================================
# WARNING: Jangan commit secrets nyata ke git!
# Gunakan environment variable atau vault untuk production.
# File ini hanya contoh konfigurasi dengan placeholder.
# ============================================

# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=omsdb_prod
DB_USERNAME=sa_prod
DB_PASSWORD=${DB_PASSWORD}

# JWT Configuration
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRATION=3600000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DATABASE=2